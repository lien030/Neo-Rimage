{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neo-rimage",
  "version": "0.1.0",
  "identifier": "su.lien.neorimage",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "neo-rimage",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "resizable": true,
        "maximizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "resources": {
      "../licenses/PROJECT-MIT.txt": "licenses/PROJECT-MIT.txt",
      "../docs/DISTRIBUTION.md": "licenses/DISTRIBUTION.md",
      "../docs/BUILDING.md": "licenses/BUILDING.md",
      "../docs/SOURCES.md": "licenses/SOURCES.md",
      "../licenses/GPL-3.0.txt": "licenses/GPL-3.0.txt",
      "../licenses/INSTALLER-NOTICES.txt": "licenses/INSTALLER-NOTICES.txt",
      "../licenses/THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
